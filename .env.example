# ==== 35xw bot configuration ====
# Copy this file to .env and fill in the values.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID from the "General Information" page of your app
CLIENT_ID=

# Your server (guild) ID. Recommended: slash commands register instantly for that server.
# Leave empty to register commands globally (can take up to an hour to appear).
GUILD_ID=

# Auto role given to everyone who joins.
# Option A: put the role ID here.
AUTO_ROLE_ID=
# Option B: leave AUTO_ROLE_ID empty and the bot uses (or creates) a role with this name.
AUTO_ROLE_NAME=Member

# The one and only bot manager (the only person allowed to use /refills, /refill5 and /n).
# Access is verified by the Discord ID only; the username is used only for display.
MANAGER_ID=1143659003327553556
MANAGER_USERNAME=35bf

# Cooldown for every command, in seconds.
COOLDOWN_SECONDS=30

# Where the bot keeps its database (db.json), steam.txt and fivem.txt.
DATA_DIR=./data

# ---- Ticket system (all optional, these are the defaults) ----
# Category that holds open/closed tickets (created automatically).
TICKET_CATEGORY_NAME=🎫 Tickets
# Each transcript gets its own channel transcript-NNNN inside categories named <prefix>01, <prefix>02, ...
TRANSCRIPT_CATEGORY_PREFIX=Transcript-
# How many transcript channels fit in one Transcript-XX category before moving to the next (max 50).
TRANSCRIPTS_PER_CATEGORY=50
# Minutes a user must wait after their ticket is closed before opening a new one.
TICKET_REOPEN_COOLDOWN_MINUTES=10

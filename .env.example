# ==== 35xw bot configuration ====
# Copy this file to .env and fill in the values.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID from the "General Information" page of your app
CLIENT_ID=

# Your server (guild) ID. Recommended: slash commands register instantly for that server.
# Leave empty to register commands globally (can take up to an hour to appear).
GUILD_ID=

# Auto role given to everyone who joins.
# Option A: put the role ID here.
AUTO_ROLE_ID=
# Option B: leave AUTO_ROLE_ID empty and the bot uses (or creates) a role with this name.
AUTO_ROLE_NAME=member

# The one and only bot manager (the only person allowed to use /refills, /refill5 and /n).
# Access is verified by the Discord ID only; the username is used only for display.
MANAGER_ID=1143659003327553556
MANAGER_USERNAME=35bf

# Cooldown for every command, in seconds.
COOLDOWN_SECONDS=30

# Where the bot keeps its database (db.json), steam.txt and fivem.txt.
DATA_DIR=./data

# ---- Ticket system (all optional, these are the defaults) ----
# Category that holds open/closed tickets (created automatically).
TICKET_CATEGORY_NAME=🎫 Tickets
# Closing a ticket saves an HTML transcript into this single private channel (created automatically).
TRANSCRIPT_CHANNEL_NAME=transcripts
# Minutes a user must wait after their ticket is closed before opening a new one.
TICKET_REOPEN_COOLDOWN_MINUTES=10

# ---- /setup server (optional) ----
# The verified role and the role that gives access to the kept category. Both are never deleted.
SETUP_VERIFIED_ROLE_ID=1545185363327193228
SETUP_SENSITIVE_ROLE_ID=1000782828402917406
# Categories that are never touched, with everything inside them (comma separated names).
SETUP_KEEP_CATEGORIES=osjetljivo
# Extra role ids that must never be deleted (comma separated). Website roles are protected too.
SETUP_PROTECTED_ROLE_IDS=
# Name of the voice channel at the top of the server that reminds people of the website.
SETUP_SITE_NAME=35xw.top

# ---- Ticket alerts (optional) ----
# Every new ticket is posted in this channel (pinging the roles) and sent as a DM to this user.
# Only the server that has the channel, or that this user owns, is announced.
TICKET_NOTIFY_USER_ID=1143659003327553556
TICKET_NOTIFY_CHANNEL_ID=1554450101802639431
TICKET_NOTIFY_ROLE_IDS=1000782828402917406,1012461646972727347,1003360702016278543,1000784296463835286

# ---- Online transcripts (optional) ----
# Every closed ticket gets its own link, opened by the "View transcript" button. Cloudflare R2:
# R2 -> create a bucket, enable its Public Development URL, create an API token with Object Read & Write.
# Leave empty to use the bot's own website instead (WEB_ENABLED), or to keep transcripts as attached files only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# ---- Anti-nuke (on by default; switch per server with /antinuke) ----
# Someone who deletes more than ANTINUKE_MAX_CHANNELS channels within the window is warned and banned.
# The owner, the manager and this bot are never touched. Trusted ids (comma separated) are skipped too.
ANTINUKE_MAX_CHANNELS=3
ANTINUKE_WINDOW_MINUTES=10
ANTINUKE_TRUSTED_IDS=

# ---- Server log (optional) ----
# Every deleted message (who deleted it, whose it was), deleted channels and roles, bans, kicks, joins,
# leaves and voice activity are posted to this channel. The bot needs to see and write in it, and it
# needs the View Audit Log permission (Administrator has it).
LOGS_ENABLED=true
LOG_CHANNEL_ID=1554450772605935626
# Include the text of deleted and edited messages. Turn on "Message Content Intent" in the Developer
# Portal (Bot page) first, otherwise the bot cannot log in.
LOG_MESSAGE_CONTENT=false
LOG_VOICE=true

# ---- Website gated by a Discord role (optional) ----
# Set to true to start the website together with the bot.
WEB_ENABLED=false
# Port to listen on (hosts often provide SERVER_PORT automatically; that is used if WEB_PORT is empty).
WEB_PORT=
# Public address of the site, e.g. https://35xw.example.com  (no trailing slash).
# In the Developer Portal -> OAuth2 -> Redirects you MUST add:  <WEB_PUBLIC_URL>/callback
WEB_PUBLIC_URL=
# Developer Portal -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=
# Server to check the role on (falls back to GUILD_ID) and the role id(s) that grant access.
# Several roles: WEB_ROLE_ID=111,222 (any of them is enough).
WEB_GUILD_ID=
WEB_ROLE_ID=
# Optional: cookie signing secret (auto-generated into DATA_DIR/web-secret.txt when empty),
# session length and how often the role is re-checked.
WEB_SESSION_SECRET=
WEB_SESSION_HOURS=24
WEB_RECHECK_MINUTES=10
